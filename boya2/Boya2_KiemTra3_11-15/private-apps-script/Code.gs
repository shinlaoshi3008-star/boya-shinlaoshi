function settings_(){const p=PropertiesService.getScriptProperties();return {sheetId:p.getProperty('SHEET_ID'),origin:p.getProperty('ALLOWED_ORIGIN'),open:p.getProperty('EXAM_OPEN')==='true'};}
function validOrigin_(origin){return /^https:\/\/[A-Za-z0-9.-]+(?::\d+)?$/.test(origin||'');}
function book_(){const c=settings_();if(!c.sheetId)throw new Error('Chưa cấu hình SHEET_ID.');if(!validOrigin_(c.origin))throw new Error('ALLOWED_ORIGIN phải là origin HTTPS, không có đường dẫn hoặc dấu / cuối.');return SpreadsheetApp.openById(c.sheetId);}
function ensureSheet_(b,name,headers){let s=b.getSheetByName(name);if(!s)s=b.insertSheet(name);if(s.getMaxColumns()<headers.length)s.insertColumnsAfter(s.getMaxColumns(),headers.length-s.getMaxColumns());if(s.getLastRow()===0){s.appendRow(headers);s.setFrozenRows(1);s.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#192936').setFontColor('#ffffff');}else if(s.getRange(1,1,1,headers.length).getValues()[0].join('|')!==headers.join('|'))throw new Error('Cấu trúc bảng không đúng. Dùng bảng riêng cho đề số 3.');return s;}
function sheet_(){return ensureSheet_(book_(),RESULT_SHEET,HEADERS);}
function setup(){const b=book_();ensureSheet_(b,RESULT_SHEET,HEADERS);const s=ensureSheet_(b,ERROR_SHEET,ERROR_HEADERS);s.setColumnWidth(6,400);s.setColumnWidth(7,320);s.setColumnWidth(8,320);s.setColumnWidth(10,420);}
function hash_(str){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(str)).map(b=>(b+256)%256).map(b=>b.toString(16).padStart(2,'0')).join('');}
function safeCell_(str){str=String(str).trim();return /^[=+\-@]/.test(str)?"'"+str:str;}
function findRow_(s,id){if(s.getLastRow()<2)return 0;const found=s.getRange(2,2,s.getLastRow()-1,1).createTextFinder(id).matchEntireCell(true).findNext();return found?found.getRow():0;}
function validate_(p){if(!p||p.examId!==EXAM_ID||!/^a_[a-f0-9]{32}$/.test(p.attemptId)||! /^[a-f0-9]{64}$/.test(p.token))throw new Error('Thông tin lượt thi không hợp lệ.');}
function authenticate_(s,p){const r=findRow_(s,p.attemptId);if(!r||s.getRange(r,18).getValue()!==hash_(p.token))throw new Error('Lượt thi hoặc mã xác nhận sai.');return r;}
function accepted_(id){return KEY[String(id)].slice();}
function grade_(answers){const scores=[0,0,0,0,0];for(const q of QUESTION_DATA)if(accepted_(q.id).includes(answers[q.id]))scores[q.section]+=q.points;return scores;}
function review_(x){return QUESTION_DATA.map((q,j)=>{const answer=String(x[META_COUNT+j]??''),accepted=accepted_(q.id);return {id:q.id,answer,accepted,correct:accepted.includes(answer),explanation:EXPLANATIONS[q.id]};});}
function summary_(s,r){const x=s.getRange(r,1,1,HEADERS.length).getValues()[0],submitted=!!x[6];const out={ok:true,attemptId:x[1],startedAt:new Date(x[5]).getTime(),serverNow:Date.now(),submitted,status:x[13],late:x[14]===true,scores:submitted?x.slice(7,12):null,total:submitted?x[12]:null};if(submitted)out.review=review_(x);return out;}
function start_(s,p){const old=findRow_(s,p.attemptId);if(old){authenticate_(s,p);return summary_(s,old);}if(!settings_().open)throw new Error('Kỳ thi đang đóng.');for(const k of ['name','className'])if(typeof p[k]!=='string'||!p[k].trim()||p[k].trim().length>80)throw new Error('Tên và lớp cần 1–80 ký tự.');const row=Array(HEADERS.length).fill('');row[0]=new Date();row[1]=p.attemptId;row[2]=EXAM_ID;row[3]=safeCell_(p.name);row[4]=safeCell_(p.className);row[5]=new Date();row[13]='Đang thi';row[17]=hash_(p.token);s.appendRow(row);SpreadsheetApp.flush();return summary_(s,s.getLastRow());}
function answers_(p){if(!p.answers||typeof p.answers!=='object'||Array.isArray(p.answers))throw new Error('Thiếu bài làm.');const ids=QUESTION_DATA.map(q=>String(q.id));if(Object.keys(p.answers).some(id=>!ids.includes(id)))throw new Error('Mã câu hỏi không hợp lệ.');const a={};for(const q of QUESTION_DATA){const v=p.answers[q.id];if(v!==undefined&&typeof v!=='string')throw new Error('Đáp án không hợp lệ.');const value=v===undefined?'':v.trim();if(value!==''&&(!/^\d+$/.test(value)||+value>=q.options.length||String(+value)!==value))throw new Error('Lựa chọn vượt giới hạn.');a[q.id]=value;}return a;}
function syncErrors_(s,r){const x=s.getRange(r,1,1,HEADERS.length).getValues()[0];if(!x[6]||x[HEADERS.length-1]===true)return;const err=ensureSheet_(book_(),ERROR_SHEET,ERROR_HEADERS);
 // Xóa bản chi tiết còn dang dở của cùng lượt thi trước khi ghi lại.
 if(err.getLastRow()>1){const ids=err.getRange(2,1,err.getLastRow()-1,1).getValues();for(let i=ids.length-1;i>=0;i--)if(ids[i][0]===x[1])err.deleteRow(i+2);}
 const rows=review_(x).filter(v=>!v.correct).map(v=>{const q=QUESTION_DATA.find(q=>q.id===v.id);return [x[1],safeCell_(x[3]),safeCell_(x[4]),q.id,q.section+1,q.prompt,v.answer===''?'Chưa trả lời':q.options[+v.answer],v.accepted.map(a=>q.options[+a]).join(' / '),v.answer===''?'Bỏ trống':'Sai',v.explanation];});
 if(rows.length)err.getRange(err.getLastRow()+1,1,rows.length,ERROR_HEADERS.length).setValues(rows);SpreadsheetApp.flush();s.getRange(r,HEADERS.length).setValue(true);
}
function submit_(s,p){const r=authenticate_(s,p);if(s.getRange(r,7).getValue()){try{syncErrors_(s,r);}catch(e){}return summary_(s,r);}const a=answers_(p),scores=grade_(a),x=s.getRange(r,1,1,HEADERS.length).getValues()[0];x[6]=new Date();scores.forEach((v,i)=>x[7+i]=v);x[12]=scores.reduce((v,w)=>v+w,0);x[13]='Đã chấm tự động';x[14]=Date.now()-new Date(x[5]).getTime()>(DURATION_MINUTES+2)*60000;x[15]=Number.isInteger(p.blurCount)?Math.max(0,Math.min(9999,p.blurCount)):0;x[16]=hash_(JSON.stringify(a));const wrong=QUESTION_DATA.filter(q=>!accepted_(q.id).includes(a[q.id]));x[18]=wrong.length;x[19]=wrong.map(q=>q.id).join(', ');QUESTION_DATA.forEach((q,i)=>x[META_COUNT+i]=a[q.id]);x[HEADERS.length-1]=false;s.getRange(r,1,1,HEADERS.length).setValues([x]);SpreadsheetApp.flush();try{syncErrors_(s,r);}catch(e){/* kết quả chính đã được lưu; lần status sau sẽ đồng bộ lại */}return summary_(s,r);}
function status_(s,p){const r=authenticate_(s,p);if(s.getRange(r,7).getValue())try{syncErrors_(s,r);}catch(e){}return summary_(s,r);}
function dongBoCauSai(){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=sheet_();for(let r=2;r<=s.getLastRow();r++)syncErrors_(s,r);}finally{lock.releaseLock();}}
function doGet(){return ContentService.createTextOutput('Boya 2 · Bài kiểm tra số 3 · Dịch vụ nhận bài.');}
function doPost(e){let p={},result;try{const raw=e&&e.parameter&&e.parameter.payload;if(typeof raw!=='string'||raw.length>12000)throw new Error('Dữ liệu vượt giới hạn.');p=JSON.parse(raw);if(!/^[a-f0-9]{64}$/.test(p.requestId))throw new Error('Mã yêu cầu sai.');validate_(p);const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=sheet_();if(p.action==='start')result=start_(s,p);else if(p.action==='submit')result=submit_(s,p);else if(p.action==='status')result=status_(s,p);else throw new Error('Tác vụ không hợp lệ.');}finally{lock.releaseLock();}}catch(err){result={ok:false,error:String(err.message||err).slice(0,180)};}const c=settings_(),origin=validOrigin_(c.origin)?c.origin:'https://invalid.invalid';const msg=JSON.stringify({type:'boya-receipt',requestId:p.requestId,result}).replace(/</g,'\\u003c');return HtmlService.createHtmlOutput('<html><body><script>window.top.postMessage('+msg+','+JSON.stringify(origin)+');<\/script></body></html>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
