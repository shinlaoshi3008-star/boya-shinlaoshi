const SECTIONS=[{label:'I · Điền từ',max:20},{label:'II · Viết lại câu',max:20},{label:'III · Sắp xếp câu',max:40},{label:'IV · Đọc trả lời',max:20}];
const RESULT='KetQua_Bai1_5_AI_v1',ERRORS='CauCanOn_Bai1_5_AI_v1',AUDIT='LichSuDiem_Bai1_5_AI_v1',ARCHIVE='LuuTru_Xoa_Bai1_5_AI_v1';
const H=['Tạo lượt','Mã lượt','Mã đề','Họ tên','Lớp','Bắt đầu','Nộp bài','Bài 1 /20','Bài 2 /20','Bài 3 /40','Bài 4 /20','Tổng /100','Điểm đã có','Trạng thái','Nộp muộn','Rời tab','Token hash','Bài làm JSON','Chấm gốc JSON','Điều chỉnh JSON','Phiên bản','AI job JSON','Cập nhật','Lỗi AI'];
