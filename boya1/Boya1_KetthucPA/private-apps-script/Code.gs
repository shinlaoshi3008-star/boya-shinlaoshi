let BANK=BANKS['BOYA1-TEST-01-V2'];
function selectBank_(id){if(!BANKS[id])throw Error('Mã đề không được hỗ trợ.');BANK=BANKS[id];EXAM_ID=BANK.examId;}

let EXAM_ID=BANK.examId;
const HEADERS=['Tạo','Mã lượt','Mã đề','Họ tên','Lớp','Bắt đầu','Nộp','Token hash','Bài làm JSON','Chấm tay JSON','Nộp trễ'];
function settings_(){const p=PropertiesService.getScriptProperties();return {sheetId:p.getProperty('SHEET_ID'),origin:p.getProperty('ALLOWED_ORIGIN'),open:p.getProperty('EXAM_OPEN')==='true',audioUrl:p.getProperty('AUDIO_URL')||''};}
function sheet_(){const c=settings_();if(!c.sheetId)throw Error('Thiếu SHEET_ID.');const b=SpreadsheetApp.openById(c.sheetId);let s=b.getSheetByName(EXAM_ID);if(!s){s=b.insertSheet(EXAM_ID);s.appendRow(HEADERS);s.setFrozenRows(1);}return s;}
function setup(){sheet_();}
function hash_(v){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(v)).map(b=>((b+256)%256).toString(16).padStart(2,'0')).join('');}
function safeCell_(v){v=String(v).trim();return /^[=+\-@]/.test(v)?"'"+v:v;}
function raw_(v){v=String(v);return /^'[=+\-@]/.test(v)?v.slice(1):v;}
function find_(s,id){if(s.getLastRow()<2)return 0;const t=s.getRange(2,2,s.getLastRow()-1,1).createTextFinder(id).matchEntireCell(true).findNext();return t?t.getRow():0;}
function validate_(p){if(p.examId!==EXAM_ID||!/^a_[a-f0-9]{32}$/.test(p.attemptId)||! /^[a-f0-9]{64}$/.test(p.token))throw Error('Thông tin lượt thi sai.');}
function authenticate_(s,p){const r=find_(s,p.attemptId);if(!r||s.getRange(r,8).getValue()!==hash_(p.token))throw Error('Lượt thi hoặc mã xác nhận sai.');return r;}
function normalize_(answers){if(!answers||typeof answers!=='object'||Array.isArray(answers))throw Error('Thiếu bài làm.');const a={};for(const q of BANK.questions){let v=answers[q.id]??'';if(typeof v!=='string')throw Error('Đáp án phải là văn bản.');v=v.trim();if(v.length>35000)throw Error('Bài làm quá dài.');if(q.options&&v!==''&&(!/^\d+$/.test(v)||+v>=q.options.length))throw Error('Lựa chọn sai.');if(['number','countgif'].includes(q.type)&&v!==''&&!/^\d{1,2}$/.test(v))throw Error('Số nét không hợp lệ.');if(q.keys&&q.type!=='tones')arrayAnswer_(q,v);if(q.type==='tones'&&v.length>20)throw Error('Cặp thanh quá dài.');if(q.type==='text'&&v.length>1200)throw Error('Câu viết quá dài.');if(['draw','trace'].includes(q.type)&&v){let strokes;try{strokes=JSON.parse(v)}catch(e){throw Error('Bài viết nét sai.')}if(!Array.isArray(strokes)||!strokes.length||strokes.length>30||strokes.some(st=>!Array.isArray(st)||!st.length||st.length>150||st.some(p=>!Array.isArray(p)||p.length!==2||p.some(n=>typeof n!=='number'||!Number.isFinite(n)||n<0||n>1))))throw Error('Nét vẽ sai.');}a[q.id]=v;}if(JSON.stringify(a).length>45000)throw Error('Bài viết nét quá dài; hãy tải bản sao và báo giáo viên.');return a;}
function accepted_(q,answer){return (q.accepted||[]).includes(answer);}
function arrayAnswer_(q,answer){if(!answer)return [];try{const a=JSON.parse(answer);if(!Array.isArray(a)||a.length!==q.keys.length||a.some(x=>typeof x!=='string'||x.length>30))throw Error();return a}catch(e){throw Error('Ô đáp án câu '+q.id+' sai định dạng.')}}
function pinyin_(v){v=String(v).trim().toLowerCase().replace(/u:/g,'ü').replace(/v/g,'ü');let tone=null;const map={'ā':['a',1],'á':['a',2],'ǎ':['a',3],'à':['a',4],'ē':['e',1],'é':['e',2],'ě':['e',3],'è':['e',4],'ī':['i',1],'í':['i',2],'ǐ':['i',3],'ì':['i',4],'ō':['o',1],'ó':['o',2],'ǒ':['o',3],'ò':['o',4],'ū':['u',1],'ú':['u',2],'ǔ':['u',3],'ù':['u',4],'ǖ':['ü',1],'ǘ':['ü',2],'ǚ':['ü',3],'ǜ':['ü',4]};let base='';for(const c of v){if(map[c]){if(tone!==null)return '!';base+=map[c][0];tone=map[c][1]}else base+=c;}const m=base.match(/^([a-zü]+)([0-5])?$/);if(!m)return '!';if(m[2]&&tone!==null&&Number(m[2])!==tone)return '!';return m[1]+(m[2]?Number(m[2])===0?5:m[2]:tone??5);}
function normalizeCell_(q,v){if(q.format==='initial')return String(v).trim().toLowerCase();if(q.format==='tones')return String(v).trim().replace(/^0$/,'5');return pinyin_(v);}
function dist_(a,b){return Math.hypot(a[0]-b[0],a[1]-b[1]);}
function resample_(points,n=32){const lengths=[0];for(let i=1;i<points.length;i++)lengths.push(lengths.at(-1)+dist_(points[i],points[i-1]));const total=lengths.at(-1);if(total<.015)return null;const out=[];let j=1;for(let i=0;i<n;i++){const at=total*i/(n-1);while(j<lengths.length-1&&lengths[j]<at)j++;const t=(at-lengths[j-1])/(lengths[j]-lengths[j-1]||1),a=points[j-1],b=points[j];out.push([a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t]);}return out;}
function traceMatch_(q,a){let strokes;try{strokes=JSON.parse(a)}catch(e){return {match:false,reason:'Chưa có bài vẽ.'}}if(!Array.isArray(strokes)||strokes.length!==q.trace.length)return {match:false,reason:'Số nét chưa khớp chữ mẫu.'};for(let i=0;i<strokes.length;i++){const user=resample_(strokes[i]),target=resample_(q.trace[i]);if(!user||!target)return {match:false,reason:'Nét '+(i+1)+' quá ngắn.'};if(dist_(user[0],target[0])>.12||dist_(user.at(-1),target.at(-1))>.12)return {match:false,reason:'Nét '+(i+1)+' chưa đúng vị trí, thứ tự hoặc hướng.'};const direct=user.reduce((s,p,j)=>s+dist_(p,target[j]),0)/user.length;const gap=Math.max(...user.map(p=>Math.min(...target.map(t=>dist_(p,t)))),...target.map(t=>Math.min(...user.map(p=>dist_(p,t)))));if(direct>.055||gap>.11)return {match:false,reason:'Nét '+(i+1)+' chưa bám sát đường mẫu.'};}return {match:true,reason:'Đủ nét, đúng thứ tự/hướng và khớp đường mẫu trong dung sai.'};}
function grade_(answers,manual){const scores=BANK.sections.map(()=>0);let pending=0;const review=BANK.questions.map(q=>{const a=String(answers[q.id]??''),m=manual[q.id];let score=0,status,blank=a==='',detail=[],feedback=m?.feedback||'';
 if(q.keys){let values=q.type==='tones'?a.trim().split(/\s*[-–,\s]\s*/).filter(Boolean):arrayAnswer_(q,a);if(values.length>q.keys.length)values=q.keys.map(()=> '!');blank=!values.some(v=>v.trim());detail=q.keys.map((key,i)=>{const v=values[i]??'',correct=normalizeCell_(q,v)===normalizeCell_(q,key);return {index:i,answer:v,accepted:key,correct,blank:!v.trim()}});score=q.points*detail.filter(d=>d.correct).length/detail.length;score=Math.round(score*100)/100;status=blank?'blank':score===q.points?'correct':score>0?'partial':'wrong';}
 else if(q.type==='trace'){const trace=traceMatch_(q,a);score=trace.match?q.points:0;feedback=trace.reason;status=blank?'blank':score?'correct':'wrong';}
 else if(q.manual){if(m&&Number.isFinite(m.score)){score=m.score;status=score===q.points?'correct':blank?'blank':score>0?'partial':'wrong';}else if(blank)status='blank';else{status='pending';pending++;}}
 else{score=accepted_(q,a)?q.points:0;status=blank?'blank':score?'correct':'wrong';}
 scores[q.section]+=score;return {id:q.id,answer:a,blank,correct:status==='correct',status,score,max:q.points,accepted:q.accepted||[],reference:q.reference||'',feedback,detail};});return {scores:scores.map(x=>Math.round(x*100)/100),total:Math.round(scores.reduce((a,b)=>a+b,0)*100)/100,pending,review};}

function summary_(s,r){const x=s.getRange(r,1,1,HEADERS.length).getValues()[0];const done=!!x[6];const g=done?grade_(JSON.parse(x[8]||'{}'),JSON.parse(x[9]||'{}')):{};return Object.assign({ok:true,examId:EXAM_ID,attemptId:x[1],startedAt:new Date(x[5]).getTime(),serverNow:Date.now(),submitted:done,late:x[10]===true,audioUrl:settings_().audioUrl},g);}
function start_(s,p){const old=find_(s,p.attemptId);if(old){authenticate_(s,p);return summary_(s,old);}const c=settings_();if(!c.open)throw Error('Kỳ thi chưa mở.');if(BANK.requiresAudio&&!/^https:\/\//.test(c.audioUrl))throw Error('Giáo viên chưa thêm file nghe.');for(const k of ['name','className'])if(typeof p[k]!=='string'||!p[k].trim()||p[k].length>80)throw Error('Họ tên và lớp cần 1–80 ký tự.');s.appendRow([new Date(),p.attemptId,EXAM_ID,safeCell_(p.name),safeCell_(p.className),new Date(),' ',hash_(p.token),'{}','{}',false].map((v,i)=>i===6?'':v));SpreadsheetApp.flush();return summary_(s,s.getLastRow());}
function submit_(s,p){const r=authenticate_(s,p);if(s.getRange(r,7).getValue())return summary_(s,r);const a=normalize_(p.answers),x=s.getRange(r,1,1,HEADERS.length).getValues()[0];x[6]=new Date();x[8]=JSON.stringify(a);x[10]=Date.now()-new Date(x[5]).getTime()>(BANK.minutes*60+30)*1000;s.getRange(r,1,1,HEADERS.length).setValues([x]);SpreadsheetApp.flush();return summary_(s,r);}
function teacherAuth_(key){const expected=PropertiesService.getScriptProperties().getProperty('TEACHER_KEY');if(!expected||expected.length<16)throw Error('Chưa cấu hình TEACHER_KEY đủ 16 ký tự.');if(typeof key!=='string'||hash_(key)!==hash_(expected))throw Error('Mã giáo viên không đúng.');}
function teacherResults(accessKey,examId){teacherAuth_(accessKey);selectBank_(examId||'BOYA1-TEST-01-V2');const s=sheet_(),rows=s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,HEADERS.length).getValues();return {examId:EXAM_ID,title:BANK.title,updatedAt:Date.now(),sections:BANK.sections,questions:BANK.questions,students:rows.filter(x=>x[2]===EXAM_ID&&x[6]).map(x=>{const g=grade_(JSON.parse(x[8]||'{}'),JSON.parse(x[9]||'{}'));return {attemptId:x[1],name:raw_(x[3]),className:raw_(x[4]),submittedAt:new Date(x[6]).getTime(),scores:g.scores,total:g.total,pending:g.pending,late:x[10]===true,answers:g.review};})};}
function teacherGrade(accessKey,attemptId,grades,examId){teacherAuth_(accessKey);selectBank_(examId||'BOYA1-TEST-01-V2');if(!/^a_[a-f0-9]{32}$/.test(attemptId)||!grades||typeof grades!=='object'||Array.isArray(grades))throw Error('Dữ liệu chấm sai.');const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=sheet_(),r=find_(s,attemptId);if(!r||!s.getRange(r,7).getValue()||s.getRange(r,3).getValue()!==EXAM_ID)throw Error('Không tìm thấy bài đã nộp.');const saved=JSON.parse(s.getRange(r,10).getValue()||'{}');for(const [id,m] of Object.entries(grades)){const q=BANK.questions.find(q=>String(q.id)===id);if(!q?.manual||!m||typeof m.score!=='number'||!Number.isFinite(m.score)||m.score<0||m.score>q.points||typeof m.feedback!=='string'||m.feedback.length>600)throw Error('Điểm hoặc nhận xét không hợp lệ.');saved[id]={score:m.score,feedback:m.feedback};}s.getRange(r,10).setValue(JSON.stringify(saved));SpreadsheetApp.flush();}finally{lock.releaseLock();}return teacherResults(accessKey,EXAM_ID);}
function doGet(e){if(e?.parameter?.page==='teacher')return HtmlService.createHtmlOutputFromFile('teacher').setTitle(BANK.title+' · Giáo viên');return ContentService.createTextOutput(BANK.title);}
function doPost(e){let p={},result;try{if(!e.parameter.payload||e.parameter.payload.length>220000)throw Error('Dữ liệu quá lớn.');p=JSON.parse(e.parameter.payload);if(!/^[a-f0-9]{64}$/.test(p.requestId))throw Error('Mã yêu cầu sai.');selectBank_(p.examId);validate_(p);const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=sheet_();if(p.action==='start')result=start_(s,p);else if(p.action==='submit')result=submit_(s,p);else if(p.action==='status')result=summary_(s,authenticate_(s,p));else throw Error('Tác vụ không hợp lệ.');}finally{lock.releaseLock();}}catch(e){result={ok:false,error:String(e.message||e).slice(0,200)};}const origin=settings_().origin;if(!/^https:\/\/[A-Za-z0-9.-]+(?::\d+)?$/.test(origin||''))return HtmlService.createHtmlOutput('Chưa cấu hình ALLOWED_ORIGIN.');const msg=JSON.stringify({type:'boya-receipt',requestId:p.requestId,result}).replace(/</g,'\\u003c');return HtmlService.createHtmlOutput('<script>window.top.postMessage('+msg+','+JSON.stringify(origin)+');<\/script>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
