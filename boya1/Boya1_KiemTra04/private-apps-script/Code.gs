"points": 4, "manual": true, "reference": "我去上海看一个朋友。", "hint": "Dùng toàn bộ các mục cho sẵn, mỗi mục một lần. Có thể thêm dấu câu. Giáo viên chấm phần này."}, {"id": 9, "section": 1, "type": "text", "prompt": "是 / 他的 / 红色 / 那辆 / 汽车 / 的", "points": 4, "manual": true, "reference": "他的汽车是那辆红色的。 / 那辆红色的汽车是他的。", "hint": "Dùng toàn bộ các mục cho sẵn, mỗi mục một lần. Có thể thêm dấu câu. Giáo viên chấm phần này."}, {"id": 10, "section": 1, "type": "text", "prompt": "做 / 没 / 他们 / 作业", "points": 4, "manual": true, "reference": "他们没做作业。", "hint": "Dùng toàn bộ các mục cho sẵn, mỗi mục một lần. Có thể thêm dấu câu. Giáo viên chấm phần này."}, {"id": 11, "section": 2, "type": "text", "prompt": "李军借书去图书馆。", "points": 6, "manual": true, "reference": "李军去图书馆借书。", "hint": "Viết lại cả câu bằng tiếng Trung sau khi sửa lỗi. Giáo viên chấm phần này."}, {"id": 12, "section": 2, "type": "text", "prompt": "他正在去汉语中心学习汉语呢。", "points": 6, "manual": true, "reference": "他去汉语中心学习汉语。 / 他正在汉语中心学习汉语呢。", "hint": "Viết lại cả câu bằng tiếng Trung sau khi sửa lỗi. Giáo viên chấm phần này."}, {"id": 13, "section": 2, "type": "text", "prompt": "我的自行车是新，不是旧。", "points": 6, "manual": true, "reference": "我的自行车是新的，不是旧的。", "hint": "Viết lại cả câu bằng tiếng Trung sau khi sửa lỗi. Giáo viên chấm phần này."}, {"id": 14, "section": 2, "type": "text", "prompt": "张红要去购物中心买一新衣服。", "points": 6, "manual": true, "reference": "张红要去购物中心买一件新衣服。", "hint": "Viết lại cả câu bằng tiếng Trung sau khi sửa lỗi. Giáo viên chấm phần này."}, {"id": 15, "section": 2, "type": "text", "prompt": "你喝不喝咖啡吗？", "points": 6, "manual": true, "reference": "你喝不喝咖啡？ / 你喝咖啡吗？", "hint": "Viết lại cả câu bằng tiếng Trung sau khi sửa lỗi. Giáo viên chấm phần này."}, {"id": 16, "section": 3, "type": "text", "prompt": "你正在干什么呢？", "points": 4, "manual": true, "reference": "我正在学习汉语呢。", "hint": "Trả lời đầy đủ bằng tiếng Trung; nội dung có thể theo hoàn cảnh của bạn. Giáo viên chấm phần này."}, {"id": 17, "section": 3, "type": "text", "prompt": "今天星期天，你打算做什么？", "points": 4, "manual": true, "reference": "我打算去看电影。", "hint": "Trả lời đầy đủ bằng tiếng Trung; nội dung có thể theo hoàn cảnh của bạn. Giáo viên chấm phần này."}, {"id": 18, "section": 3, "type": "text", "prompt": "你去哪儿换钱？", "points": 4, "manual": true, "reference": "我去银行换钱。", "hint": "Trả lời đầy đủ bằng tiếng Trung; nội dung có thể theo hoàn cảnh của bạn. Giáo viên chấm phần này."}, {"id": 19, "section": 3, "type": "text", "prompt": "购物中心的东西怎么样？", "points": 4, "manual": true, "reference": "购物中心的东西还可以，不过有点儿贵。", "hint": "Trả lời đầy đủ bằng tiếng Trung; nội dung có thể theo hoàn cảnh của bạn. Giáo viên chấm phần này."}, {"id": 20, "section": 3, "type": "text", "prompt": "越南的冬天冷不冷？最冷多少度？", "points": 4, "manual": true, "reference": "越南有些地方冬天冷，有些地方不冷。我住的地方最冷大约十度。（ví dụ giả định; nhiệt độ tùy nơi ở, không có một đáp án duy nhất）", "hint": "Trả lời đầy đủ bằng tiếng Trung; nội dung có thể theo hoàn cảnh của bạn. Giáo viên chấm phần này."}]};
const EXAM_ID=BANK.examId, HEADERS=['Tạo','Mã lượt','Mã đề','Họ tên','Lớp','Bắt đầu','Nộp','Token hash','Bài làm JSON','Chấm tay JSON','Nộp trễ'];
function settings_(){const p=PropertiesService.getScriptProperties();return {sheetId:p.getProperty('SHEET_ID'),origin:p.getProperty('ALLOWED_ORIGIN'),open:p.getProperty('EXAM_OPEN')==='true',audioUrl:p.getProperty('AUDIO_URL')||''};}
function sheet_(){const c=settings_();if(!c.sheetId)throw Error('Thiếu SHEET_ID.');const b=SpreadsheetApp.openById(c.sheetId);let s=b.getSheetByName(EXAM_ID);if(!s){s=b.insertSheet(EXAM_ID);s.appendRow(HEADERS);s.setFrozenRows(1);}return s;}
function setup(){sheet_();}
function hash_(v){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(v)).map(b=>((b+256)%256).toString(16).padStart(2,'0')).join('');}
function safeCell_(v){v=String(v).trim();return /^[=+\-@]/.test(v)?"'"+v:v;}
function raw_(v){v=String(v);return /^'[=+\-@]/.test(v)?v.slice(1):v;}
function find_(s,id){if(s.getLastRow()<2)return 0;const t=s.getRange(2,2,s.getLastRow()-1,1).createTextFinder(id).matchEntireCell(true).findNext();return t?t.getRow():0;}
function validate_(p){if(p.examId!==EXAM_ID||!/^a_[a-f0-9]{32}$/.test(p.attemptId)||! /^[a-f0-9]{64}$/.test(p.token))throw Error('Thông tin lượt thi sai.');}
function authenticate_(s,p){const r=find_(s,p.attemptId);if(!r||s.getRange(r,8).getValue()!==hash_(p.token))throw Error('Lượt thi hoặc mã xác nhận sai.');return r;}
function normalize_(answers){if(!answers||typeof answers!=='object'||Array.isArray(answers))throw Error('Thiếu bài làm.');const a={};for(const q of BANK.questions){let v=answers[q.id]??'';if(typeof v!=='string')throw Error('Đáp án phải là văn bản.');v=v.trim();if(v.length>35000)throw Error('Bài làm quá dài.');if(q.options&&v!==''&&(!/^\d+$/.test(v)||+v>=q.options.length))throw Error('Lựa chọn sai.');if(q.type==='number'&&v!==''&&!/^\d{1,2}$/.test(v))throw Error('Số nét không hợp lệ.');if(q.type==='text'&&v.length>1200)throw Error('Câu viết quá dài.');if(q.type==='draw'&&v){let strokes;try{strokes=JSON.parse(v)}catch(e){throw Error('Bài viết nét sai.')}if(!Array.isArray(strokes)||!strokes.length||strokes.length>30||strokes.some(st=>!Array.isArray(st)||!st.length||st.length>150||st.some(p=>!Array.isArray(p)||p.length!==2||p.some(n=>typeof n!=='number'||!Number.isFinite(n)||n<0||n>1))))throw Error('Nét vẽ sai.');}a[q.id]=v;}if(JSON.stringify(a).length>45000)throw Error('Bài viết nét quá dài; hãy tải bản sao và báo giáo viên.');return a;}
function accepted_(q,answer){return (q.accepted||[]).includes(answer);}
function grade_(answers,manual){const scores=BANK.sections.map(()=>0);let pending=0;const review=BANK.questions.map(q=>{const a=String(answers[q.id]??''),blank=a==='',m=manual[q.id];let score=0,status;if(q.manual){if(m&&Number.isFinite(m.score)){score=m.score;status=score===q.points?'correct':blank?'blank':score>0?'partial':'wrong';}else if(blank){status='blank';}else{status='pending';pending++;}}else{score=accepted_(q,a)?q.points:0;status=blank?'blank':score?'correct':'wrong';}scores[q.section]+=score;return {id:q.id,answer:a,blank,correct:status==='correct',status,score,max:q.points,accepted:q.accepted||[],reference:q.reference||'',feedback:m?.feedback||''};});return {scores,total:scores.reduce((a,b)=>a+b,0),pending,review};}
function summary_(s,r){const x=s.getRange(r,1,1,HEADERS.length).getValues()[0];const done=!!x[6];const g=done?grade_(JSON.parse(x[8]||'{}'),JSON.parse(x[9]||'{}')):{};return Object.assign({ok:true,examId:EXAM_ID,attemptId:x[1],startedAt:new Date(x[5]).getTime(),serverNow:Date.now(),submitted:done,late:x[10]===true,audioUrl:settings_().audioUrl},g);}
function start_(s,p){const old=find_(s,p.attemptId);if(old){authenticate_(s,p);return summary_(s,old);}const c=settings_();if(!c.open)throw Error('Kỳ thi chưa mở.');if(BANK.requiresAudio&&!/^https:\/\//.test(c.audioUrl))throw Error('Giáo viên chưa thêm file nghe.');for(const k of ['name','className'])if(typeof p[k]!=='string'||!p[k].trim()||p[k].length>80)throw Error('Họ tên và lớp cần 1–80 ký tự.');s.appendRow([new Date(),p.attemptId,EXAM_ID,safeCell_(p.name),safeCell_(p.className),new Date(),' ',hash_(p.token),'{}','{}',false].map((v,i)=>i===6?'':v));SpreadsheetApp.flush();return summary_(s,s.getLastRow());}
function submit_(s,p){const r=authenticate_(s,p);if(s.getRange(r,7).getValue())return summary_(s,r);const a=normalize_(p.answers),x=s.getRange(r,1,1,HEADERS.length).getValues()[0];x[6]=new Date();x[8]=JSON.stringify(a);x[10]=Date.now()-new Date(x[5]).getTime()>(BANK.minutes*60+30)*1000;s.getRange(r,1,1,HEADERS.length).setValues([x]);SpreadsheetApp.flush();return summary_(s,r);}
function teacherAuth_(key){const expected=PropertiesService.getScriptProperties().getProperty('TEACHER_KEY');if(!expected||expected.length<16)throw Error('Chưa cấu hình TEACHER_KEY đủ 16 ký tự.');if(typeof key!=='string'||hash_(key)!==hash_(expected))throw Error('Mã giáo viên không đúng.');}
function teacherResults(accessKey){teacherAuth_(accessKey);const s=sheet_(),rows=s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,HEADERS.length).getValues();return {examId:EXAM_ID,title:BANK.title,updatedAt:Date.now(),sections:BANK.sections,questions:BANK.questions,students:rows.filter(x=>x[2]===EXAM_ID&&x[6]).map(x=>{const g=grade_(JSON.parse(x[8]||'{}'),JSON.parse(x[9]||'{}'));return {attemptId:x[1],name:raw_(x[3]),className:raw_(x[4]),submittedAt:new Date(x[6]).getTime(),scores:g.scores,total:g.total,pending:g.pending,late:x[10]===true,answers:g.review};})};}
function teacherGrade(accessKey,attemptId,grades){teacherAuth_(accessKey);if(!/^a_[a-f0-9]{32}$/.test(attemptId)||!grades||typeof grades!=='object'||Array.isArray(grades))throw Error('Dữ liệu chấm sai.');const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=sheet_(),r=find_(s,attemptId);if(!r||!s.getRange(r,7).getValue()||s.getRange(r,3).getValue()!==EXAM_ID)throw Error('Không tìm thấy bài đã nộp.');const saved=JSON.parse(s.getRange(r,10).getValue()||'{}');for(const [id,m] of Object.entries(grades)){const q=BANK.questions.find(q=>String(q.id)===id);if(!q?.manual||!m||typeof m.score!=='number'||!Number.isFinite(m.score)||m.score<0||m.score>q.points||typeof m.feedback!=='string'||m.feedback.length>600)throw Error('Điểm hoặc nhận xét không hợp lệ.');saved[id]={score:m.score,feedback:m.feedback};}s.getRange(r,10).setValue(JSON.stringify(saved));SpreadsheetApp.flush();}finally{lock.releaseLock();}return teacherResults(accessKey);}
function doGet(e){if(e?.parameter?.page==='teacher')return HtmlService.createHtmlOutputFromFile('teacher').setTitle(BANK.title+' · Giáo viên');return ContentService.createTextOutput(BANK.title);}
function doPost(e){let p={},result;try{if(!e.parameter.payload||e.parameter.payload.length>220000)throw Error('Dữ liệu quá lớn.');p=JSON.parse(e.parameter.payload);if(!/^[a-f0-9]{64}$/.test(p.requestId))throw Error('Mã yêu cầu sai.');validate_(p);const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=sheet_();if(p.action==='start')result=start_(s,p);else if(p.action==='submit')result=submit_(s,p);else if(p.action==='status')result=summary_(s,authenticate_(s,p));else throw Error('Tác vụ không hợp lệ.');}finally{lock.releaseLock();}}catch(e){result={ok:false,error:String(e.message||e).slice(0,200)};}const origin=settings_().origin;if(!/^https:\/\/[A-Za-z0-9.-]+(?::\d+)?$/.test(origin||''))return HtmlService.createHtmlOutput('Chưa cấu hình ALLOWED_ORIGIN.');const msg=JSON.stringify({type:'boya-receipt',requestId:p.requestId,result}).replace(/</g,'\\u003c');return HtmlService.createHtmlOutput('<script>window.top.postMessage('+msg+','+JSON.stringify(origin)+');<\/script>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
